{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/reels", "destination": "https://t.me/New_TradeLikeTYO_bot?start=reels", "permanent": false },
    { "source": "/razbor", "destination": "https://t.me/New_TradeLikeTYO_bot?start=razbor", "permanent": false },
    { "source": "/kurs", "destination": "https://t.me/New_TradeLikeTYO_bot?start=kurs", "permanent": false },
    { "source": "/([Yy][Oo][Uu][Tt][Uu][Bb][Ee])", "destination": "https://t.me/New_TradeLikeTYO_bot?start=youtube", "permanent": false },
    { "source": "/shorts", "destination": "https://t.me/New_TradeLikeTYO_bot?start=shorts", "permanent": false },
    { "source": "/([Ss][Tt][Oo][Rr][Ii][Ee][Ss])", "destination": "https://t.me/New_TradeLikeTYO_bot?start=stories", "permanent": false },
    { "source": "/tiktok", "destination": "https://t.me/New_TradeLikeTYO_bot?start=tiktok", "permanent": false },
    { "source": "/site", "destination": "https://t.me/New_TradeLikeTYO_bot?start=site", "permanent": false },
    { "source": "/bio", "destination": "https://t.me/New_TradeLikeTYO_bot?start=bio", "permanent": false },
    { "source": "/warm", "destination": "https://t.me/New_TradeLikeTYO_bot?start=warm", "permanent": false },
    { "source": "/p-telegram", "destination": "https://t.me/New_TradeLikeTYO_bot?start=posevT", "permanent": false },
    { "source": "/telegram", "destination": "https://t.me/New_TradeLikeTYO_bot?start=telegram", "permanent": false },
    { "source": "/start", "destination": "https://t.me/New_TradeLikeTYO_bot", "permanent": false },
    { "source": "/viktor", "destination": "https://t.me/New_TradeLikeTYO_bot?start=viktor", "permanent": false },
    { "source": "/vk", "destination": "https://t.me/New_TradeLikeTYO_bot?start=vk", "permanent": false },
    { "source": "/([Ff][Aa][Cc][Ee][Bb][Oo][Oo][Kk])", "destination": "https://t.me/New_TradeLikeTYO_bot?start=facebook", "permanent": false },

    { "source": "/([Ii][Gg])", "destination": "/?utm_source=instagram", "permanent": false },
    { "source": "/([Ii][Gg])-([Bb][Ii][Oo])", "destination": "/?utm_source=ig_bio", "permanent": false },
    { "source": "/([Ii][Gg])-([Rr][Ee][Ee][Ll][Ss])", "destination": "/?utm_source=ig_reels", "permanent": false },
    { "source": "/([Ii][Gg])-([Ss][Tt][Oo][Rr][Ii][Ee][Ss])", "destination": "/?utm_source=ig_stories", "permanent": false }
  ],
  "headers": [
    {
      "source": "/school",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/school/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/access",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/preview-:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
